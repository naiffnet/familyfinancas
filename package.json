{
  "name": "financeiro-familiar",
  "version": "1.0.0",
  "description": "App de Orçamento Familiar",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "web": "electron server.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "start:server": "node server.js",
    "start:server:local": "electron server.js",
    "build:renderer": "node scripts/concat-modules.js",
    "watch:renderer": "node scripts/concat-modules.js --watch",
    "dist:win": "node scripts/concat-modules.js && npx electron-builder --win --x64",
    "test": "electron scripts/run-tests.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.financasfamilia.app",
    "productName": "FinançasFamília",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "naiffnet",
        "repo": "familyfinancas"
      }
    ],
    "files": [
      "src/**/*",
      "server.js",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/renderer/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FinançasFamília"
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^3.11.174",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^33.4.4",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
